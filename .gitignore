.env
__pycache__/
*.pyc
.venv/

# Raw trial data (large JSONL files)
data/raw_responses/trials.jsonl
data/processed/scored_trials.jsonl

# Cached third-party sources, fetched by scripts/introduction_corpus/ and regenerable.
# Not committed: these are full copies of other authors' papers and figures, and this
# repository is public.
.workspace/reference/intro_corpus/html/
.workspace/reference/figure_examples/

# Build outputs, regenerable with tectonic
paper/builds/

# Section .bak safety copies taken mid-edit; the committed history is the real record
paper/sections/.*.bak*

# Exploratory figure candidates, regenerable from paper/figures/gen_*.py
.workspace/scratch/*.png

# Maps the anonymised rater labels back to real names. Must never be committed:
# this repository is public, and the paper is anonymised for review.
.workspace/reference/rater_key.md
