      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Code Revises More",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code Revises More",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0166",
      "type": "text",
      "x": 452,
      "y": 2783,
      "width": 376,
      "height": 52.650000000000006,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1643004187,
      "version": 1,
      "versionNonce": 166320907,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Code tasks elicit more genuine revision\nthan other domains, consistently across\n5 out of 6 models.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code tasks elicit more genuine revision\nthan other domains, consistently across\n5 out of 6 models.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0167",
      "type": "text",
      "x": 452,
      "y": 2845,
      "width": 376,
      "height": 32.400000000000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2021598246,
      "version": 1,
      "versionNonce": 955345538,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Code revision rate: 34%\nOther domains:      20-25%",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code revision rate: 34%\nOther domains:      20-25%",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0168",
      "type": "text",
      "x": 452,
      "y": 2895,
      "width": 376,
      "height": 105.30000000000001,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 857158769,
      "version": 1,
      "versionNonce": 1976987349,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Why? Code has concrete targets: a\nfailing test, a bug, a missing edge\ncase. That built-in directed signal\nis the same thing targeted feedback\nprovides. Code naturally has what\nother domains lack.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why? Code has concrete targets: a\nfailing test, a bug, a missing edge\ncase. That built-in directed signal\nis the same thing targeted feedback\nprovides. Code naturally has what\nother domains lack.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0169",
