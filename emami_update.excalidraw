    {
      "id": "el_0007",
      "type": "text",
      "x": 552,
      "y": 56,
      "width": 520,
      "height": 56.7,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 939042956,
      "version": 1,
      "versionNonce": 999270937,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "LLMs don't know when to stop revising. Left unchecked,\nthey degrade their own output, and that is a massive\nproblem for any multi-turn workflow.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLMs don't know when to stop revising. Left unchecked,\nthey degrade their own output, and that is a massive\nproblem for any multi-turn workflow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
