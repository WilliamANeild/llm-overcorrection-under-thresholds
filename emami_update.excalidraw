    {
      "id": "el_0161",
      "type": "text",
      "x": 42,
      "y": 2783,
      "width": 376,
      "height": 35.1,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 760434129,
      "version": 1,
      "versionNonce": 1770791024,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Revision rate is bimodal, not a\ngradient. There is no middle ground.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Revision rate is bimodal, not a\ngradient. There is no middle ground.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0162",
      "type": "text",
      "x": 42,
      "y": 2835,
      "width": 376,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 106456635,
      "version": 1,
      "versionNonce": 770348180,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Change-requesting probes: ~100%\nAssessment-requesting:    2-39%\nGap between clusters:     ~60pp",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Change-requesting probes: ~100%\nAssessment-requesting:    2-39%\nGap between clusters:     ~60pp",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0163",
      "type": "text",
      "x": 42,
      "y": 2900,
      "width": 376,
      "height": 70.2,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1426725703,
      "version": 1,
      "versionNonce": 1768294571,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "The gate is semantic. If the prompt\nasks for change, models comply. If\nit asks for assessment, most decline.\nNo probe lands in the middle.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The gate is semantic. If the prompt\nasks for change, models comply. If\nit asks for assessment, most decline.\nNo probe lands in the middle.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0164",
