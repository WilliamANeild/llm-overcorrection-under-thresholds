      "updated": 1718000000000,
      "link": null,
      "locked": false
    },
    {
      "id": "el_0165",
      "type": "text",
      "x": 452,
      "y": 2751,
      "width": 336,
      "height": 22.950000000000003,
      "angle": 0,
      "strokeColor": "#087f5b",
