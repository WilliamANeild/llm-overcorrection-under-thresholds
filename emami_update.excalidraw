      "versionNonce": 304330004,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "When you tell an LLM to \"keep improving\"\nwithout saying what to fix, quality goes\ndown, not up.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When you tell an LLM to \"keep improving\"\nwithout saying what to fix, quality goes\ndown, not up.",
      "autoResize": true,
      "lineHeight": 1.25
    },
