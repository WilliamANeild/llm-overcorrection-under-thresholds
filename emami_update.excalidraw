    },
    {
      "id": "el_0082",
      "type": "text",
      "x": 42,
      "y": 1295,
      "width": 376,
      "height": 52.650000000000006,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
