      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FINDING vs METHODS",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0010",
      "type": "text",
      "x": 1132,
      "y": 56,
      "width": 480,
      "height": 70.2,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
