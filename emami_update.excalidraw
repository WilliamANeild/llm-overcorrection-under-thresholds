      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Human raters themselves only agreed\nat similar levels, so the judge is\nroughly as reliable as a human.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Human raters themselves only agreed\nat similar levels, so the judge is\nroughly as reliable as a human.",
