      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Winner: Claude Sonnet 4\nJudge-human kappa: 0.526\nSpearman r: 0.505",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Winner: Claude Sonnet 4\nJudge-human kappa: 0.526\nSpearman r: 0.505",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0015",
