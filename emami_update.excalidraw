      "text": "1. REVISION MAKES IT WORSE",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. REVISION MAKES IT WORSE",
