      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "We needed a reliable automated judge\nbefore running 720 trials. Tested 6\nLLM judges against 3 human raters.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We needed a reliable automated judge\nbefore running 720 trials. Tested 6\nLLM judges against 3 human raters.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0014",
