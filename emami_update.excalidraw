      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Three Model Clusters",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Three Model Clusters",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0171",
      "type": "text",
      "x": 862,
      "y": 2783,
      "width": 376,
      "height": 52.650000000000006,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 101637980,
      "version": 1,
      "versionNonce": 829486136,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Under change-probes, all models are\nidentical (~100%). Under assessment-\nprobes, they split into three clusters:",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Under change-probes, all models are\nidentical (~100%). Under assessment-\nprobes, they split into three clusters:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0172",
      "type": "text",
      "x": 862,
      "y": 2850,
      "width": 376,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1711398353,
      "version": 1,
      "versionNonce": 1409874349,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Gate-open:  Llama, Claude\nGate-gated: GPT-4o, Qwen\nGate-shut:  Gemini, DeepSeek",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gate-open:  Llama, Claude\nGate-gated: GPT-4o, Qwen\nGate-shut:  Gemini, DeepSeek",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0173",
      "type": "text",
      "x": 862,
      "y": 2910,
      "width": 376,
      "height": 70.2,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1196591019,
      "version": 1,
      "versionNonce": 298159857,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "The divergence is 0-90% on the\nevaluative side. Models differ in\nhow they interpret ambiguity, not\nin whether they can revise.",
      "fontSize": 13,
