      "lineHeight": 1.25
    },
    {
      "id": "el_0093",
      "type": "text",
      "x": 562,
      "y": 1295,
      "width": 376,
      "height": 52.650000000000006,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1729245243,
      "version": 1,
      "versionNonce": 1457293576,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "Three out of four post-T1 responses are\nnot real revisions. They are polite\ndeclines or commentary, not edits.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Three out of four post-T1 responses are\nnot real revisions. They are polite\ndeclines or commentary, not edits.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "el_0094",
      "type": "text",
      "x": 562,
      "y": 1365,
      "width": 376,
      "height": 32.400000000000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 469306920,
      "version": 1,
      "versionNonce": 1067970821,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1718000000000,
      "link": null,
      "locked": false,
      "text": "75% of post-T1 = meta-responses\nGenuine revision: 39% at T2 -> 13% at T5",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "75% of post-T1 = meta-responses\nGenuine revision: 39% at T2 -> 13% at T5",
      "autoResize": true,
      "lineHeight": 1.25
    },
