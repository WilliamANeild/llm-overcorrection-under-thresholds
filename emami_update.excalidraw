      "text": "2. MOST MODELS JUST STOP",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. MOST MODELS JUST STOP",
